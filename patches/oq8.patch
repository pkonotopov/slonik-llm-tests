@@ -5106,3 +5106,36 @@ select * from (select a, b from phv_boolpart) t
 (2 rows)
 
 drop table phv_boolpart;
+--
+-- OR-clause pruning with a default partition: a step that yields no bound
+-- offsets but must scan the default (or null) partition should not be skipped
+-- when combining step results.
+--
+create table or_prune (k int, label text) partition by list (k);
+create table or_prune_a partition of or_prune for values in (1,2);
+create table or_prune_b partition of or_prune for values in (10,20);
+create table or_prune_null partition of or_prune for values in (null);
+create table or_prune_default partition of or_prune default;
+insert into or_prune values (1,'a1'),(2,'a2'),(10,'b10'),(20,'b20'),
+  (99,'keep'),(99,'drop'),(null,'nil'),(-7,'keep');
+explain (costs off)
+select k,label from or_prune where k = 20 or (k = 99 and label = 'keep') order by k,label;
+                                QUERY PLAN                                 
+---------------------------------------------------------------------------
+ Sort
+   Sort Key: or_prune.k, or_prune.label
+   ->  Append
+         ->  Seq Scan on or_prune_b or_prune_1
+               Filter: ((k = 20) OR ((k = 99) AND (label = 'keep'::text)))
+         ->  Seq Scan on or_prune_default or_prune_2
+               Filter: ((k = 20) OR ((k = 99) AND (label = 'keep'::text)))
+(7 rows)
+
+select k,label from or_prune where k = 20 or (k = 99 and label = 'keep') order by k,label;
+ k  | label 
+----+-------
+ 20 | b20
+ 99 | keep
+(2 rows)
+
+drop table or_prune;

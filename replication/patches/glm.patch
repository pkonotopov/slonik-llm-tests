diff --git a/src/test/subscription/t/036_stream_partial_serialize_reclaim.pl b/src/test/subscription/t/036_stream_partial_serialize_reclaim.pl
new file mode 100644
index 0000000..d830c93
--- /dev/null
+++ b/src/test/subscription/t/036_stream_partial_serialize_reclaim.pl
@@ -0,0 +1,161 @@
+
+# Copyright (c) 2025, PostgreSQL Global Development Group
+
+# Test that an aborted suffix of a partially serialized streaming transaction
+# is reclaimed from the spool file while the outer transaction is still open,
+# without breaking the replay of the spooled changes by the parallel apply
+# worker.
+use strict;
+use warnings FATAL => 'all';
+use PostgreSQL::Test::Cluster;
+use PostgreSQL::Test::Utils;
+use Test::More;
+
+my $publisher = PostgreSQL::Test::Cluster->new('publisher');
+$publisher->init(allows_streaming => 'logical');
+$publisher->append_conf('postgresql.conf',
+	'debug_logical_replication_streaming = immediate');
+$publisher->start;
+
+my $subscriber = PostgreSQL::Test::Cluster->new('subscriber');
+$subscriber->init;
+$subscriber->append_conf('postgresql.conf', 'log_min_messages = debug1');
+$subscriber->start;
+
+my $appname   = 'tap_sub';
+my $publisher_connstr = $publisher->connstr . ' dbname=postgres';
+
+$publisher->safe_psql('postgres',
+	'CREATE TABLE tab (a int PRIMARY KEY, payload text);
+	 CREATE TABLE gate (a int PRIMARY KEY);');
+$subscriber->safe_psql('postgres',
+	'CREATE TABLE tab (a int PRIMARY KEY, payload text);
+	 CREATE TABLE gate (a int PRIMARY KEY);');
+
+$publisher->safe_psql('postgres',
+	'CREATE PUBLICATION tap_pub FOR TABLE tab, gate');
+$subscriber->safe_psql('postgres',
+	"CREATE SUBSCRIPTION $appname CONNECTION '$publisher_connstr application_name=$appname' PUBLICATION tap_pub WITH (streaming = parallel, copy_data = false)"
+);
+
+$subscriber->wait_for_subscription_sync($publisher, $appname);
+
+# Total size of the subscriber's spool files.
+my $spool_dir = $subscriber->data_dir . '/base/pgsql_tmp';
+my $spool_bytes = sub {
+	my $total = 0;
+	return 0 unless -d $spool_dir;
+	opendir(my $dh, $spool_dir) or return 0;
+	for my $entry (readdir($dh))
+	{
+		next if $entry eq '.' or $entry eq '..';
+		if (-f "$spool_dir/$entry" && $entry =~ /\.changes\./)
+		{
+			$total += -s "$spool_dir/$entry";
+		}
+		elsif (-d _)
+		{
+			opendir(my $sdh, "$spool_dir/$entry") or next;
+			for my $file (grep { /\.changes\./ } readdir($sdh))
+			{
+				$total += -s "$spool_dir/$entry/$file";
+			}
+			closedir($sdh);
+		}
+	}
+	closedir($dh);
+	return $total;
+};
+
+is($spool_bytes->(), 0, 'no spool files at start');
+
+my $offset = -s $subscriber->logfile;
+
+# Start a streamed transaction which is handed to a parallel apply worker,
+# then block the worker on a lock held by another session, so that the leader
+# has to serialize the rest of the transaction to a file.
+my $pub_session = $publisher->background_psql('postgres');
+my $sub_session = $subscriber->background_psql('postgres');
+
+$pub_session->query_safe(
+	q{
+BEGIN;
+SAVEPOINT outer_sp;
+INSERT INTO tab VALUES (1, NULL);
+SELECT pg_logical_emit_message(false, 'flush', '', true);
+});
+
+# Wait for the parallel apply worker to process the first streaming block.
+$subscriber->wait_for_log(
+	qr/DEBUG: ( [A-Z0-9]+:)? defining savepoint/,
+	$offset);
+
+$sub_session->query_safe( 'BEGIN; LOCK gate IN ACCESS EXCLUSIVE MODE;');
+
+# Wait until the parallel apply worker is blocked on the gate lock.
+$subscriber->poll_query_until(
+	'postgres',
+	"SELECT EXISTS (SELECT 1 FROM pg_stat_subscription
+	              WHERE leader_pid IS NOT NULL
+	                AND cardinality(pg_blocking_pids(pid)) > 0)")
+  or die "timed out waiting for the parallel apply worker to block";
+
+# The parallel apply worker is blocked now; the next big streamed block is
+# serialized to a file.
+$offset = -s $subscriber->logfile;
+$pub_session->query_safe(
+	q{
+SAVEPOINT sp;
+INSERT INTO gate VALUES (1);
+INSERT INTO tab VALUES (2, repeat('x', 20 * 1024 * 1024));
+SELECT pg_logical_emit_message(false, 'flush', '', true);
+});
+
+# Ensure that the changes are serialized.
+$subscriber->wait_for_log(
+	qr/LOG: ( [A-Z0-9]+:)? logical replication apply worker will serialize the remaining changes of remote transaction \d+ to a file/,
+	$offset);
+
+ok($spool_bytes->() > 4 * 1024 * 1024, 'spool file holds the serialized changes'
+);
+
+# Rolling back to the savepoint aborts the serialized changes, and the leader
+# must reclaim the space in the spool file while the outer transaction is
+# still open.
+$offset = -s $subscriber->logfile;
+$pub_session->query_safe( 'ROLLBACK TO sp;');
+
+$subscriber->wait_for_log(
+	qr/DEBUG: ( [A-Z0-9]+:)? reclaimed \d+ bytes from partial stream/,
+	$offset);
+
+ok($spool_bytes->() < 4 * 1024 * 1024,
+	'spool file was truncated after the abort');
+
+# Unblock the parallel apply worker and finish the transaction.
+$sub_session->query_safe( 'COMMIT;');
+$pub_session->query_safe(
+	q{
+INSERT INTO tab VALUES (3, NULL);
+COMMIT;
+});
+
+$publisher->wait_for_catchup($appname);
+
+# The aborted batch must not have been applied, and the spool must be gone.
+my $result = $subscriber->safe_psql('postgres', 'SELECT a FROM tab ORDER BY 1');
+is($result, "1\n3", 'aborted subtransaction was not applied');
+
+$result = $subscriber->safe_psql('postgres', 'SELECT count(*) FROM gate');
+is($result, '0', 'aborted gate insert was not applied');
+
+is($spool_bytes->(), 0, 'no spool files left after commit');
+
+# Make sure the apply worker did not hit any error meanwhile.
+my $log = slurp_file($subscriber->logfile, $offset);
+ok($log !~ /^ERROR:/ms, 'no errors in subscriber log');
+
+$pub_session->quit;
+$sub_session->quit;
+
+done_testing();

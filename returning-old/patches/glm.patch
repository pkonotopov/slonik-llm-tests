diff --git a/src/test/isolation/specs/update-returning-concurrent.spec b/src/test/isolation/specs/update-returning-concurrent.spec
new file mode 100644
index 0000000..19b715f
--- /dev/null
+++ b/src/test/isolation/specs/update-returning-concurrent.spec
@@ -0,0 +1,45 @@
+# Tests for UPDATE ... RETURNING OLD/NEW when the target tuple was
+# concurrently updated.  In READ COMMITTED, the tuple update can be
+# rechecked against the tuple's latest version by EvalPlanQual during
+# BEFORE ROW UPDATE trigger processing (see ExecBRUpdateTriggers).  In
+# that case RETURNING OLD.* must report the values of the tuple
+# actually updated, that is, the latest version, not the stale one
+# originally found by the query.
+
+setup
+{
+  CREATE TABLE ret (id int PRIMARY KEY, n int NOT NULL);
+  CREATE FUNCTION pass_new() RETURNS trigger LANGUAGE plpgsql
+  AS $$ BEGIN RETURN NEW; END; $$;
+  CREATE TRIGGER touch BEFORE UPDATE ON ret
+    FOR EACH ROW EXECUTE FUNCTION pass_new();
+  INSERT INTO ret VALUES (1, 7);
+}
+
+teardown
+{
+  DROP TABLE ret;
+  DROP FUNCTION pass_new();
+}
+
+session s1
+setup { BEGIN ISOLATION LEVEL READ COMMITTED; }
+step s1u { UPDATE ret SET n = n + 10 WHERE id = 1; }
+step s1c { COMMIT; }
+step s1r { ROLLBACK; }
+
+session s2
+setup { BEGIN ISOLATION LEVEL READ COMMITTED; }
+step s2u { UPDATE ret SET n = n + 1 WHERE id = 1 RETURNING OLD.n, NEW.n; }
+step s2c { COMMIT; }
+
+session s3
+step s3sel { SELECT n FROM ret ORDER BY id; }
+
+# s2 waits for s1, then updates the version s1 committed.  OLD must be
+# the version immediately before s2's update (17), not the one seen by
+# s2's query snapshot (7).
+permutation s1u s2u s1c s2u s2c s3sel
+
+# Same, but s1 rolls back, so s2 updates the tuple it originally saw.
+permutation s1u s2u s1r s2u s2c s3sel

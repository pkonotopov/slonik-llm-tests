diff --git a/src/backend/executor/nodeModifyTable.c b/src/backend/executor/nodeModifyTable.c
index 7c1d0e9..0c371fa 100644
--- a/src/backend/executor/nodeModifyTable.c
+++ b/src/backend/executor/nodeModifyTable.c
@@ -2480,6 +2480,29 @@ ExecUpdate(ModifyTableContext *context, ResultRelInfo *resultRelInfo,
 	if (!ExecUpdatePrologue(context, resultRelInfo, tupleid, oldtuple, slot, NULL))
 		return NULL;
 
+
+
+	/*
+	 * If a BEFORE ROW UPDATE trigger is present, the prologue has already
+	 * locked the target tuple (via GetTupleForTrigger) and, if it was
+	 * concurrently updated, re-locked the latest version.  In that case
+	 * ExecUpdateAct below will not report TM_Updated, so the refresh of
+	 * ri_oldTupleSlot normally done in that case would never happen.  Do it
+	 * here instead, so that RETURNING OLD references the latest row version
+	 * rather than the one fetched when the tuple was scanned.
+	 */
+	if (context->tmfd.traversed && ItemPointerIsValid(tupleid) &&
+		resultRelInfo->ri_oldTupleSlot != NULL)
+	{
+		if (unlikely(!resultRelInfo->ri_projectNewInfoValid))
+			ExecInitUpdateProjection(context->mtstate, resultRelInfo);
+
+		oldSlot = resultRelInfo->ri_oldTupleSlot;
+		if (!table_tuple_fetch_row_version(resultRelationDesc, tupleid,
+										   SnapshotAny, oldSlot))
+			elog(ERROR, "failed to fetch tuple being updated");
+	}
+
 	/* INSTEAD OF ROW UPDATE Triggers */
 	if (resultRelInfo->ri_TrigDesc &&
 		resultRelInfo->ri_TrigDesc->trig_update_instead_row)

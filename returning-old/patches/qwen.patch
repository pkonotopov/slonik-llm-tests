diff --git a/src/test/isolation/specs/update-returning-old-trigger.spec b/src/test/isolation/specs/update-returning-old-trigger.spec
new file mode 100644
index 0000000..cedda73
--- /dev/null
+++ b/src/test/isolation/specs/update-returning-old-trigger.spec
@@ -0,0 +1,37 @@
+# Test that UPDATE ... RETURNING OLD reports the latest committed row
+# version after waiting for a concurrent writer, when a BEFORE UPDATE
+# row trigger is present.  Without the fix, OLD.n reports the value
+# fetched at scan time (7) instead of the value locked after A commits (17).
+
+setup
+{
+    CREATE TABLE urt_table(id int PRIMARY KEY, n int);
+    INSERT INTO urt_table VALUES (1, 7);
+
+    CREATE FUNCTION urt_pass_new() RETURNS trigger LANGUAGE plpgsql AS $body$
+    BEGIN
+        RETURN NEW;
+    END;
+    $body$;
+
+    CREATE TRIGGER urt_bu BEFORE UPDATE ON urt_table
+        FOR EACH ROW EXECUTE PROCEDURE urt_pass_new();
+}
+
+teardown
+{
+    DROP TABLE urt_table;
+    DROP FUNCTION urt_pass_new();
+}
+
+session s1
+step s1b { BEGIN; }
+step s1u { UPDATE urt_table SET n = n + 10 WHERE id = 1; }
+step s1c { COMMIT; }
+
+session s2
+step s2b { BEGIN ISOLATION LEVEL READ COMMITTED; }
+step s2r { UPDATE urt_table SET n = n + 1 WHERE id = 1 RETURNING OLD.n, NEW.n; }
+step s2c { COMMIT; }
+
+permutation s1b s1u s2b s2r s1c s2c
